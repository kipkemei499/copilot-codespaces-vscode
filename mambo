<xml xmlns="http://www.w3.org/1999/xhtml" collection="false">
  <variables>
    <variable type="" id="MaxLoss">Max Loss Amount</variable>
    <variable type="" id="ExpectedProfit">Expected Profit</variable>
    <variable type="" id="InitialAmount">Initial Amount</variable>
    <variable type="" id="WinAmount">Win Amount</variable>
    <variable type="" id="NextTradeCondition">Next Trade Condition</variable>
  </variables>
  
  <block type="trade" id="trade" x="-229" y="-91">
    <field name="MARKET_LIST">volidx</field>
    <field name="SUBMARKET_LIST">random_index</field>
    <field name="SYMBOL_LIST">R_50</field>
    <field name="TRADETYPECAT_LIST">digits</field>
    <field name="TRADETYPE_LIST">overunder</field>
    <field name="TYPE_LIST">both</field>
    <field name="CANDLEINTERVAL_LIST">60</field>
    <field name="TIME_MACHINE_ENABLED">FALSE</field>
    <field name="RESTARTONERROR">TRUE</field>
    
    <statement name="INITIALIZATION">
      <block type="variables_set" id="set_initial_values">
        <field name="VAR" id="MaxLoss">Max Loss Amount</field>
        <value name="VALUE">
          <block type="math_number" id="MaxLossValue">
            <field name="NUM">50</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="set_expected_profit">
            <field name="VAR" id="ExpectedProfit">Expected Profit</field>
            <value name="VALUE">
              <block type="math_number" id="ExpectedProfitValue">
                <field name="NUM">25</field>
              </block>
            </value>
          </block>
        </next>
      </block>
    </statement>
    
    <statement name="SUBMARKET">
      <block type="tradeOptions" id="trade_options">
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="CURRENCY_LIST">USD</field>
        <value name="DURATION">
          <block type="math_number" id="DurationValue">
            <field name="NUM">1</field>
          </block>
        </value>
        <value name="AMOUNT">
          <block type="variables_get" id="InitialAmountVar">
            <field name="VAR" id="InitialAmount">Initial Amount</field>
          </block>
        </value>
      </block>
    </statement>
  </block>
  
  <block type="before_purchase" id="strategy" x="348" y="-90">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="if_trade_condition">
        <mutation else="1"></mutation>
        <value name="IF0">
          <block type="logic_compare" id="CheckCondition">
            <field name="OP">EQ</field>
            <value name="A">
              <block type="variables_get" id="NextTradeConditionVar">
                <field name="VAR" id="NextTradeCondition">Next Trade Condition</field>
              </block>
            </value>
            <value name="B">
              <block type="text" id="EvenText">
                <field name="TEXT">Even</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="purchase" id="purchase_even">
            <field name="PURCHASE_LIST">DIGITOVER</field>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="purchase" id="purchase_odd">
            <field name="PURCHASE_LIST">DIGITUNDER</field>
          </block>
        </statement>
      </block>
    </statement>
  </block>

  <block type="after_purchase" id="finish" x="-227" y="297">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="check_win">
        <value name="IF0">
          <block type="contract_check_result" id="CheckWin">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <statement name="DO0">
          <block type="notify" id="WinNotification">
            <field name="NOTIFICATION_TYPE">success</field>
            <value name="MESSAGE">
              <block type="text" id="WinMessage">
                <field name="TEXT">Trade Won</field>
              </block>
            </value>
          </block>
        </statement>
      </block>
      
      <block type="controls_if" id="check_loss">
        <value name="IF0">
          <block type="contract_check_result" id="CheckLoss">
            <field name="CHECK_RESULT">loss</field>
          </block>
        </value>
        <statement name="DO0">
          <block type="notify" id="LossNotification">
            <field name="NOTIFICATION_TYPE">warn</field>
            <value name="MESSAGE">
              <block type="text" id="LossMessage">
                <field name="TEXT">Trade Lost</field>
              </block>
            </value>
          </block>
        </statement>
      </block>
    </statement>
  </block>
</xml>
